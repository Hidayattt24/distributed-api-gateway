FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY . .
RUN sh ./gradlew :examples:user-service:bootJar --no-daemon

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/examples/user-service/build/libs/user-service-0.1.0-SNAPSHOT.jar /app/user-service.jar
EXPOSE 8081
CMD ["java", "-jar", "/app/user-service.jar"]
