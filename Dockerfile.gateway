FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY . .
RUN sh ./gradlew :gateway:gateway-runtime:installDist --no-daemon

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/gateway/gateway-runtime/build/install/gateway-runtime /app/gateway
COPY config/gateway.properties /app/config/gateway.properties
EXPOSE 8080
CMD ["/app/gateway/bin/gateway-runtime"]
