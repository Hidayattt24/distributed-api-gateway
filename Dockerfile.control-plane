FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY . .
RUN sh ./gradlew :control-plane:bootJar --no-daemon

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/control-plane/build/libs/control-plane-0.1.0-SNAPSHOT.jar /app/control-plane.jar
COPY config/gateway.properties /app/config/gateway.properties
EXPOSE 9090
ENTRYPOINT ["java", "-jar", "/app/control-plane.jar"]
