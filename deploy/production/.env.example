GATEWAY_IMAGE=distributed-api-gateway@sha256:REPLACE_WITH_DIGEST
CONTROL_PLANE_IMAGE=distributed-api-gateway-control-plane@sha256:REPLACE_WITH_DIGEST
API_SERVICE_URL=http://api-service:8080
GATEWAY_ALLOWED_UPSTREAMS=http://api-service:8080
REDIS_URL=redis-sentinel://sentinel-1:26379,sentinel-2:26379,sentinel-3:26379/0#mymaster
CONTROL_DATABASE_URL=jdbc:postgresql://postgres-ha:5432/gateway
CONTROL_DATABASE_USER=gateway

# Set private values only in deploy/production/.env.
CONTROL_PLANE_TOKEN=
CONTROL_DATABASE_PASSWORD=
API_KEY_SECRET=
RATE_LIMIT_API_API_KEY_SHA256=
